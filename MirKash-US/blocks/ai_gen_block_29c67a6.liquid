{% doc %}
  @prompt
    collapsible tab foe seo visible only when content was there heading, rich text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-seo-tab-{{ ai_gen_id }} {
    border: 1px solid {{ settings.color_border }};
    border-radius: 4px;
    margin-bottom: 16px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-seo-tab-header-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    transition: background-color 0.3s ease;
  }

  .ai-seo-tab-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
  }

  .ai-seo-tab-header-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ settings.color_accent }};
    outline-offset: 2px;
  }

  .ai-seo-tab-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 12px;
  }

  .ai-seo-tab-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-seo-tab-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-seo-tab-content-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.padding_horizontal }}px {{ block.settings.padding_vertical }}px;
    border-top: 1px solid {{ settings.color_border }};
    background-color: {{ block.settings.content_background_color }};
    display: none;
  }

  .ai-seo-tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} * {
    color: {{ block.settings.content_text_color }};
    font-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
    font-size: {{ block.settings.content_font_size }}px;
    line-height: {{ block.settings.content_line_height }};
  }

  .ai-seo-tab-content-{{ ai_gen_id }} h1,
  .ai-seo-tab-content-{{ ai_gen_id }} h2,
  .ai-seo-tab-content-{{ ai_gen_id }} h3,
  .ai-seo-tab-content-{{ ai_gen_id }} h4,
  .ai-seo-tab-content-{{ ai_gen_id }} h5,
  .ai-seo-tab-content-{{ ai_gen_id }} h6 {
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} p {
    margin-bottom: 16px;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} ul,
  .ai-seo-tab-content-{{ ai_gen_id }} ol {
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} a {
    color: {{ settings.color_accent }};
    text-decoration: underline;
  }

  .ai-seo-tab-content-{{ ai_gen_id }} a:hover {
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .ai-seo-tab-header-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-seo-tab-content-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.padding_horizontal | times: 0.8 }}px {{ block.settings.padding_vertical | times: 0.8 }}px;
    }

    .ai-seo-tab-content-{{ ai_gen_id }} * {
      font-size: {{ block.settings.content_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

{% if block.settings.heading != blank and block.settings.content != blank %}
  <seo-collapsible-tab-{{ ai_gen_id }}
    class="ai-seo-tab-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <button
      class="ai-seo-tab-header-{{ ai_gen_id }}"
      aria-expanded="{{ block.settings.default_open }}"
      aria-controls="ai-seo-tab-content-{{ ai_gen_id }}"
      type="button"
    >
      <span>{{ block.settings.heading }}</span>
      <svg
        class="ai-seo-tab-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6,9 12,15 18,9"></polyline>
      </svg>
    </button>
    <div
      id="ai-seo-tab-content-{{ ai_gen_id }}"
      class="ai-seo-tab-content-{{ ai_gen_id }}{% if block.settings.default_open %} active{% endif %}"
      role="region"
      aria-labelledby="ai-seo-tab-header-{{ ai_gen_id }}"
    >
      {{ block.settings.content }}
    </div>
  </seo-collapsible-tab-{{ ai_gen_id }}>
{% endif %}

<script>
  (function() {
    class SeoCollapsibleTab{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-seo-tab-header-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-seo-tab-content-{{ ai_gen_id }}');
        
        if (this.button && this.content) {
          this.setupEventListeners();
        }
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => {
          this.toggleTab();
        });

        this.button.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            this.toggleTab();
          }
        });
      }

      toggleTab() {
        const isExpanded = this.button.getAttribute('aria-expanded') === 'true';
        
        this.button.setAttribute('aria-expanded', !isExpanded);
        
        if (isExpanded) {
          this.content.classList.remove('active');
        } else {
          this.content.classList.add('active');
        }
      }
    }

    customElements.define('seo-collapsible-tab-{{ ai_gen_id }}', SeoCollapsibleTab{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "SEO collapsible tab",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tab heading",
      "default": "Additional Information"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Tab content",
      "default": "<p>Add your SEO-friendly content here. This tab will only appear when both heading and content are provided.</p>"
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Tab heading style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#151515"
    },
    {
      "type": "header",
      "content": "Content style"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Content font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Content line height",
      "default": 1.5
    },
    {
      "type": "color",
      "id": "content_text_color",
      "label": "Content text color",
      "default": "#151515"
    },
    {
      "type": "header",
      "content": "Background colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tab background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Tab hover background",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "SEO collapsible tab"
    }
  ]
}
{% endschema %}