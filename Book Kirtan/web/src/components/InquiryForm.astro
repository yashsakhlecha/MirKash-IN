---
---

<section id="inquiry">
  <div class="inquiry-inner">
    <h2 class="inquiry-headline">
      Every occasion is different.<br />Tell us about yours.
    </h2>
    <form id="inquiry-form">
      <div class="form-field">
        <label class="form-label" for="name">Your name</label>
        <input class="form-input" id="name" name="name" type="text" placeholder="Full name" required />
      </div>
      <div class="form-field">
        <label class="form-label" for="occasion">What's the occasion?</label>
        <select class="form-select" id="occasion" name="occasion" required>
          <option value="" disabled selected>Select an occasion</option>
          <option value="wedding">Wedding</option>
          <option value="griha-pravesh">Griha Pravesh</option>
          <option value="satsang">Satsang</option>
          <option value="antim-ardas">Antim Ardas</option>
          <option value="navratri">Navratri</option>
          <option value="corporate">Corporate</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label class="form-label" for="date">Date</label>
          <input class="form-input" id="date" name="date" type="text" placeholder="Approximate is fine" />
        </div>
        <div class="form-field">
          <label class="form-label" for="city">City</label>
          <input class="form-input" id="city" name="city" type="text" placeholder="Where is it?" />
        </div>
      </div>
      <div class="form-field">
        <label class="form-label" for="message">Anything else we should know</label>
        <textarea
          class="form-textarea"
          id="message"
          name="message"
          placeholder="Scale of the gathering, tradition preference, any specific requests…"
        ></textarea>
      </div>
      <div class="form-submit-row">
        <button type="submit" class="btn-primary">Send inquiry</button>
        <a href="https://wa.me/919999999999" class="whatsapp-link">
          Or reach us on WhatsApp → +91 99999 99999
        </a>
      </div>
    </form>
    <div class="form-success" id="form-success">
      Thank you. We'll be in touch within a day.
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLDivElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.style.display = 'none';
    success.style.display = 'block';
  });
</script>
