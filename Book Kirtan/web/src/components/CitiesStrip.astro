---
const cities = [
  { name: 'Mumbai', slug: 'mumbai' },
  { name: 'Delhi', slug: 'delhi' },
  { name: 'Amritsar', slug: 'amritsar' },
  { name: 'Bangalore', slug: 'bangalore' },
  { name: 'Pune', slug: 'pune' },
  { name: 'Chandigarh', slug: 'chandigarh' },
];
---

<section id="cities">
  <p class="section-label">Artists by city</p>
  <div class="cities-row">
    {cities.map((city, i) => (
      <>
        <a href={`/cities/${city.slug}`} class="city-link">{city.name}</a>
        {i < cities.length - 1 && <span class="city-sep">·</span>}
      </>
    ))}
  </div>
</section>
