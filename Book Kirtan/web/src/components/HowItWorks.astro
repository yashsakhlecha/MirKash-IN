---
const steps = [
  {
    num: '01',
    head: 'Tell us',
    body: 'You share the occasion, the sangat, what you\'re looking for. A few lines is enough.',
  },
  {
    num: '02',
    head: 'We find the right match',
    body: 'We know the artists. We make the introduction based on tradition, scale, and occasion.',
  },
  {
    num: '03',
    head: 'One conversation',
    body: 'You don\'t negotiate with five artists. We handle the logistics.',
  },
];
---

<section id="how">
  <p class="section-label">How it works</p>
  <div class="how-grid">
    {steps.map((step) => (
      <div class="how-step">
        <div class="how-step-num">{step.num}</div>
        <h3 class="how-step-head">{step.head}</h3>
        <p class="how-step-body">{step.body}</p>
      </div>
    ))}
  </div>
</section>
