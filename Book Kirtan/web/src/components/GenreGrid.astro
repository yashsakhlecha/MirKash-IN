---
const genres = [
  { name: 'Shabad Kirtan', slug: 'shabad' },
  { name: 'Gurbani Kirtan', slug: 'gurbani' },
  { name: 'ISKCON & Hare Krishna', slug: 'iskcon' },
  { name: 'Hindu Bhajan', slug: 'bhajan' },
  { name: 'Yoga Kirtan', slug: 'yoga' },
  { name: 'Bhajan Mandali', slug: 'mandali' },
];
---

<section id="genres" class="grid-section">
  <p class="section-label">Every tradition</p>
  <div class="tile-grid">
    {genres.map((genre) => (
      <a href={`/genres/${genre.slug}`} class="tile">
        <div class="tile-bg"></div>
        <div class="tile-overlay"></div>
        <div class="tile-label-wrap">
          <span class="tile-name">{genre.name}</span>
          <div class="tile-arrow">Explore artists →</div>
        </div>
      </a>
    ))}
  </div>
</section>
