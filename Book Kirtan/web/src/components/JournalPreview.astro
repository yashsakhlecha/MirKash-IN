const articles = [
  {
    tag: 'Tradition',
    headline: 'What makes a kirtan artist right for a wedding?',
    date: 'April 2025',
    slug: 'kirtan-artist-for-wedding',
  },
  {
    tag: 'Occasions',
    headline: 'The quiet gravity of Antim Ardas',
    date: 'March 2025',
    slug: 'antim-ardas',
  },
  {
