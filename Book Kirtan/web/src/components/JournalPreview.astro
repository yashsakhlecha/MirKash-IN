---

<section id="journal">
  <div class="journal-header">
    <p class="section-label" style="margin-bottom:0;">Journal</p>
    <a href="/journal" class="journal-read-more">Read the journal →</a>
  </div>
  <div class="journal-grid">
    {articles.map((article) => (
      <a href={`/journal/${article.slug}`} style="text-decoration:none;">
        <article class="journal-card">
          <span class="journal-tag">{article.tag}</span>
          <h3 class="journal-headline">{article.headline}</h3>
          <div class="journal-rule"></div>
          <span class="journal-date">{article.date}</span>
        </article>
      </a>
    ))}
  </div>
</section>
