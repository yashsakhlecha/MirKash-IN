---
const occasions = [
  { name: 'Wedding', slug: 'wedding' },
  { name: 'Griha Pravesh', slug: 'griha-pravesh' },
  { name: 'Satsang', slug: 'satsang' },
  { name: 'Antim Ardas', slug: 'antim-ardas' },
  { name: 'Navratri', slug: 'navratri' },
  { name: 'Corporate', slug: 'corporate' },
];
---

<section id="occasions" class="grid-section" style="padding-top: 0;">
  <p class="section-label">Every occasion</p>
  <div class="tile-grid">
    {occasions.map((occasion) => (
      <a href={`/occasions/${occasion.slug}`} class="tile">
        <div class="tile-bg" style="background: repeating-linear-gradient(-45deg,#2e1f1a,#2e1f1a 2px,#271a15 2px,#271a15 14px);"></div>
        <div class="tile-overlay"></div>
        <div class="tile-label-wrap">
          <span class="tile-name">{occasion.name}</span>
          <div class="tile-arrow">Explore artists →</div>
        </div>
      </a>
    ))}
  </div>
</section>
